# adm-web 环境变量样例。复制为 .env.local 做本机覆盖（.env.local 不入库）。
# 开发期默认值见 .env.development，生产默认值见 .env.production。

# ---------- 接口与构建 ----------

# 接口运行时前缀。开发期默认 /api（由 Vite 反代到 127.0.0.1:9007 并剥掉 /api）。
# 直连远端：VITE_API_BASE=http://10.0.0.7:9007
VITE_API_BASE=/api

# pnpm dev 时 adm-svr 的反代目标，仅开发期生效。
# VITE_PROXY_TARGET=http://10.0.0.7:9007

# 部署在子路径时必填：决定 index.html 里资源引用的前缀与 Router basename，
# 必须与 nginx 的 location 一字不差（含末尾斜杠）。生产值写在 .env.production。
# PUBLIC_BASE=/adm-web/

# 路由模式。默认 browser（需要静态服务器把未知路径回退到 index.html）；
# 静态服务器不能配置 SPA 回退时设为 hash，前端会改用 HashRouter。
# VITE_ROUTER=hash

# ---------- 跨服务 widget ----------

# 各服务 widget 数据的网关基地址，留空表示与页面同源。
# VITE_GATEWAY_BASE=https://gateway.example.com

# 按逻辑服务名覆盖基地址（JSON 对象字符串，优先级高于 VITE_GATEWAY_BASE）。
# VITE_SERVICE_BASES='{"jobx":"/jobx-svr","oss":"https://gateway.example.com/oss-svr"}'

# 开发期直连目标（vite proxy），不配置时使用本机默认端口。
# VITE_OSS_TARGET=http://127.0.0.1:9840
# VITE_MSG_TARGET=http://127.0.0.1:9002
# VITE_JOBX_TARGET=http://127.0.0.1:9001
