# `pnpm build` 自动读取本文件（Vite 的 production 模式）。
# 临时换部署位置不用改这里：命令行环境变量优先级更高，例如
#   PUBLIC_BASE=/adm-web-test/ pnpm build

# 页面挂载路径，必须与 nginx 的 location 完全一致（注意末尾斜杠）。
# 它同时决定 index.html 里 /assets/* 的前缀和前端路由的 basename。
PUBLIC_BASE=/adm-rs-web/

# 接口前缀：生产默认「同源 + 网关按 /adm/* 转发」，所以留空。
# 若后端挂在别的前缀（例如 /adm-svr），按实际值填写。
VITE_API_BASE=/adm-rs-svr

# 认证模式：生产必须登录。缺省值同样是 required，这里显式写出来便于检查。
VITE_AUTH_MODE=required
# 认证接口前缀（登录 / me / 登出）。
VITE_AUTH_BASE=/adm-rs-svr
