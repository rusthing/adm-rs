<o:EntityAttribute Id="o167">
<a:ObjectID>5D1491FA-F28A-42D6-A635-CCF02DAF6C63</a:ObjectID>
<a:Name>ID</a:Name>
<a:Code>id</a:Code>
<a:CreationDate>1793495245</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1793550000</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>主键
代理键，由框架生成（雪花 ID），业务层不需要关心取值</a:Comment>
