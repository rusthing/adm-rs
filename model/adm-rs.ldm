<a:CreationDate>1793514236</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1793550000</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>排序值
同一分组内排序，越小越靠前
@range 0..=9999</a:Comment>
<a:DataType>I</a:DataType>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:GlobalObjectID/>
</o:EntityAttribute>
<o:EntityAttribute Id="o338">
<a:ObjectID>A9599096-20EC-4AE1-A06D-2C5FAFA4BD2F</a:ObjectID>
